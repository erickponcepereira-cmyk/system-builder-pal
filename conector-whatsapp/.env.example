# Endereço do FitMind (sem barra no fim)
FITMIND_URL=https://fitmindclub.com.br

# Copie do painel: Admin > WhatsApp da plataforma > botão "ID da conexão"
FITMIND_CONEXAO_ID=

# Copie do painel: Admin > WhatsApp da plataforma > botão "Chave de conexão"
FITMIND_SEGREDO=

# Opcional: caminho do Chrome (ou Edge) instalado no computador.
# Só preencha se o conector disser que não encontrou o navegador.
# Exemplo: CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
